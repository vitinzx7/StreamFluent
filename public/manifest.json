{
  "manifest_version": 3,
  "name": "StreamFluent",
  "version": "0.1.0",
  "description": "Legendas para estudar idiomas na Netflix, Max e players HTML5 do Cinetaro.",
  "permissions": ["storage", "unlimitedStorage"],
  "background": { "service_worker": "background.js" },
  "host_permissions": [
    "https://api.dictionaryapi.dev/*",
    "https://clients5.google.com/*",
    "https://api.mymemory.translated.net/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "StreamFluent"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.max.com/*",
        "*://*.hbomax.com/*",
        "https://cinetaro.to/*",
        "https://www.cinetaro.to/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["netflix-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://cinextream.cc/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["library.html"],
      "matches": ["*://*.netflix.com/*", "*://*.max.com/*", "*://*.hbomax.com/*"]
    }
  ]
}
